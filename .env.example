# Free Jarvis — example environment configuration
# Your Personal AI. Your Device. Your Rules.
#
# Copy this file to .env and edit the copy locally. .env is gitignored.
# NEVER commit real keys or credentials. Every value below is intentionally
# empty: this file contains placeholders only, no secrets.
#
# Free Jarvis is local-first: a local Ollama model is the default and no cloud
# account or API key is required. Cloud provider credentials are optional and
# never required — export your own keys only if you deliberately enable a
# cloud engine, and keep them outside version control.

# --- Data locations -------------------------------------------------------
# Preferred root for config, databases, caches, logs, skills, and credentials.
# Leave empty to use the default ~/.openjarvis directory.
FREE_JARVIS_HOME=
# Legacy alias, honored for existing installs. FREE_JARVIS_HOME takes
# precedence when both are set.
OPENJARVIS_HOME=

# Explicit path to config.toml (optional; empty means <home>/config.toml).
FREE_JARVIS_CONFIG=
# Legacy alias for the explicit config file path.
OPENJARVIS_CONFIG=

# --- Local inference ------------------------------------------------------
# Ollama endpoint used for local inference (default: http://localhost:11434).
# No cloud key is needed for this path.
OLLAMA_HOST=
# Ollama context window for vision / screen-capture queries (default: 16384).
JARVIS_NUM_CTX=

# --- API server (optional) ------------------------------------------------
# Authentication key for the API server. Optional with the default loopback
# bind (127.0.0.1); REQUIRED when binding to a non-loopback address. Generate
# your own value locally and never commit it.
OPENJARVIS_API_KEY=
# Reserved for future frontend-host configuration; application code currently
# binds local services to 127.0.0.1. Do not expose the UI on a network address
# without the API key above and HTTPS termination.
FREE_JARVIS_WEB_HOST=
