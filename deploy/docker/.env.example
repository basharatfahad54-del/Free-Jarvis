# Free Jarvis — copy to `.env` in this directory (deploy/docker/.env) before
# `docker compose up`. docker-compose.yml requires this — the container binds
# 0.0.0.0 internally, so the server refuses to start without an API key.
#
# Generate a key with:  openssl rand -hex 32
# Then clients must send:  Authorization: Bearer <key>
#
# Host ports bind to 127.0.0.1 by default. Remote access requires an API key
# AND HTTPS (put a TLS reverse proxy in front of the loopback port).
# Persistent state (config/data/history/memory) lives in the `free-jarvis-state`
# volume mounted at /home/openjarvis/.openjarvis (the default data dir).
# Legacy note: OPENJARVIS_* variables below are still supported.
OPENJARVIS_API_KEY=
